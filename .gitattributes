# Line endings.
#
# core.autocrlf is on for this checkout, so without these rules Git hands out
# CRLF files on Windows. A shell script with CRLF fails on Linux — bash reads
# the carriage return as part of the interpreter path and reports
# "bad interpreter: No such file or directory". Since the whole point of these
# scripts is that they run on Linux, pin them.

* text=auto

*.sh   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.csv  text eol=lf
*.xml  text eol=lf

# Binary — never touched.
*.woff  binary
*.woff2 binary
*.png   binary
*.jpg   binary
*.svg   text eol=lf
