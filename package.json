{
  "name": "tradeline-btc-intelligence",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "geoip": "esbuild scripts/build-geoip.ts --bundle --platform=node --format=cjs --alias:@=./src --outfile=.tmp/geoip.cjs --log-level=warning && node .tmp/geoip.cjs",
    "samples": "esbuild scripts/emit-sample.ts --bundle --platform=node --format=cjs --alias:@=./src --outfile=.tmp/emit.cjs --log-level=warning && node .tmp/emit.cjs",
    "inspect": "esbuild scripts/inspect-model.ts --bundle --platform=node --format=cjs --alias:@=./src --outfile=.tmp/inspect.cjs --log-level=warning && node .tmp/inspect.cjs",
    "inspect:clean": "esbuild scripts/inspect-clean.ts --bundle --platform=node --format=cjs --alias:@=./src --outfile=.tmp/clean.cjs --log-level=warning && node .tmp/clean.cjs",
    "inspect:imported": "esbuild scripts/inspect-imported.ts --bundle --platform=node --format=cjs --alias:@=./src --outfile=.tmp/imported.cjs --log-level=warning && node .tmp/imported.cjs",
    "verify": "esbuild scripts/verify-pipeline.ts --bundle --platform=node --format=cjs --alias:@=./src --outfile=.tmp/verify.cjs --log-level=warning && node .tmp/verify.cjs"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/caudex": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "clsx": "^2.1.1",
    "d3-force-3d": "^3.0.5",
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "three-stdlib": "^2.36.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
